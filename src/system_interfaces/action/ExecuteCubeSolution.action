# Goal: 저장된 풀이를 명시적으로 실행
string scan_id
string workflow_id
bool dry_run
# Invoke the registered pretrained model once at each primitive stage.
bool run_pretrained_policies
system_interfaces/OpenLoopPolicyState initial_open_loop_state
---
# Result
bool success
bool dry_run
string scan_id
string execution_id
uint32 completed_moves
uint32 completed_steps
string error_code
string error_message
# Policy outputs, in primitive order. action_sizes delimits the flattened values.
string[] policy_ids
uint32[] policy_action_sizes
float64[] policy_action_values
---
# Feedback
system_interfaces/CubeExecutionStatus status
