{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Middleware Bridge Cube Control Desk",
  "version": "0.1.0",
  "identifier": "dev.middlewarebridge.ros2check",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "큐브 조작 스테이션 · Middleware Bridge",
        "width": 1440,
        "height": 1000,
        "minWidth": 920,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ws://127.0.0.1:9090 ws://localhost:9090; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
